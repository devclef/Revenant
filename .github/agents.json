{
  "_comment": "Path ownership per role agent. Used by pr-policy CI and the dispatcher. Keep in sync with fs_write rules in .kiro/agents/*.json. Paths not owned by any role (.kiro/**, .github/**, tools/agents/**, tools/dispatcher/**, tools/hooks/**, scripts/check.sh, docs/kiro-writeup.md) are owner-only or unowned. Test files under src/ are shared so a ticket that changes behaviour can update the tests it outdates; pr_policy still refuses deleting another role's test.",
  "shared": [
    "package.json",
    "package-lock.json",
    ".env.example",
    "src/test/integration/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "roles": {
    "platform-dev": [
      "*.config.*",
      "tsconfig.json",
      "next-env.d.ts",
      ".gitignore",
      ".dockerignore",
      ".nvmrc",
      "Dockerfile",
      "deploy/**",
      "drizzle/**",
      "drizzle.config.*",
      "scripts/migrate.mjs",
      "src/middleware.ts",
      "src/middleware.test.ts",
      "src/app/layout.tsx",
      "src/app/page.tsx",
      "src/app/globals.css",
      "src/app/api/health/**",
      "src/lib/db/**",
      "src/lib/*.ts",
      "src/lib/*.test.ts",
      "src/test/**",
      "public/**",
      "README.md",
      "docs/video-script.md",
      "docs/writeup-gaps.md",
      "tools/qa/**",
      "scripts/check-js-budget.mjs"
    ],
    "frontend-dev": [
      "src/app/**/*.tsx",
      "src/app/**/*.css",
      "src/app/fonts/**",
      "src/components/**",
      "src/lib/cards/**",
      "src/lib/ics/**",
      "src/lib/recall/**",
      "src/lib/personas/**",
      "content/personas/**",
      "public/**"
    ],
    "data-dev": [
      "src/lib/sources/**",
      "src/lib/figures/**",
      "src/lib/events/**",
      "src/app/api/figures/**",
      "src/lib/db/schema/figures*",
      "drizzle/**",
      "scripts/fetch-figures*",
      "scripts/prefetch*"
    ],
    "crypto-dev": [
      "src/lib/crypto/**",
      "src/lib/seal-format/**",
      "src/app/api/letters/**",
      "src/app/api/openings/**",
      "src/lib/db/schema/letters*",
      "drizzle/**",
      "scripts/seal-personas*",
      "src/lib/letter-store/**",
      "src/test/integration/**"
    ]
  },
  "exclude_from_size": [
    "package-lock.json",
    "drizzle/meta/**",
    "scripts/fetch-figures.mjs",
    "scripts/seal-personas.mjs",
    "dist/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "max_changed_lines": 5000
}
