# Overrides the application version reported by src/lib/version.ts.
# When unset, the version falls back to the "version" field in package.json.
APP_VERSION=

# PostgreSQL connection string used by the Drizzle client and the migrate script.
DATABASE_URL=

# Passkey relying-party ID (hostname) and the app origin. Both are fixed
# configuration: RP_ID is required by the Live_Letter routes (503 when unset).
RP_ID=
APP_ORIGIN=

# Where GET /api/figures reads figures: `db` (default) or `file`. `file` serves
# the bundled src/lib/figures/real/fuel-figures.json and fetch-status.json.
FIGURES_SOURCE=

# Freshness check (scripts/fetch-figures-freshness.mjs, run by CI, not by the app).
# GITHUB_TOKEN needs issue write access to GITHUB_REPOSITORY (owner/name). It is
# never sent to the figures endpoint. FRESHNESS_ASSIGNEE is the GitHub login the
# Freshness_Issue is assigned to.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
FRESHNESS_ASSIGNEE=
