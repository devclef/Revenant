{
  "name": "qa",
  "description": "Revenant independent reviewer: checks a PR against its ticket and the steering docs, writes .qa/verdict.json.",
  "prompt": "file://./prompts/qa.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code",
    "@playwright"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "@playwright"
  ],
  "includeMcpJson": false,
  "mcpServers": {
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "PLAYWRIGHT_MCP_OUTPUT_DIR=\"$HOME/kiro/revenant-crew/qa-shots\" exec npx -y @playwright/mcp@0.0.83 --headless --browser chromium --isolated --file-paths absolute"
      ],
      "timeout": 120000
    }
  },
  "hooks": {},
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://.kiro/agents/prompts/common.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".qa/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/**",
          ".github/**",
          "tools/**",
          "scripts/check.sh"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "npm *",
          "npx *",
          "node *",
          "bash scripts/check.sh*",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git rev-parse*",
          "git ls-files*",
          "ls*",
          "mkdir *",
          "pwd",
          "git add .qa*",
          "git commit *",
          "git fetch origin*",
          "git merge-base*",
          "helm lint*",
          "helm template*",
          "docker run*",
          "docker rm*",
          "docker stop*",
          "npm run build",
          "npm start*",
          "npm run db:migrate",
          "npm run seal-personas*",
          "PORT=* npm start*",
          "PORT=* DATABASE_URL=* npm start*",
          "DATABASE_URL=* npm run db:migrate",
          "DATABASE_URL=* npm run seal-personas*",
          "kill *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git remote*",
          "git config*",
          "git reset*",
          "git checkout main*",
          "gh *",
          "sudo *",
          "kubectl *",
          "helm install*",
          "helm upgrade*",
          "rm -rf /*",
          "rm -rf ~*",
          "env",
          "printenv*",
          "*github.com*",
          "*api.github*",
          "cd *",
          "*&& cd *",
          "*; cd *",
          "pushd *",
          "*--prefix*",
          "npm -g*",
          "npm * -g*",
          "npm *--global*",
          "npx --yes*",
          "*~/*",
          "*$HOME*",
          "*/home/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "playwright/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "playwright/browser_run_code_unsafe",
          "playwright/browser_file_upload"
        ],
        "effect": "deny"
      }
    ]
  },
  "model": "claude-haiku-5.5"
}
