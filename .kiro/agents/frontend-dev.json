{
  "name": "frontend-dev",
  "description": "Revenant UI engineer: pages, components, styling, cards, .ics, recall wording, persona text.",
  "prompt": "file://./prompts/frontend-dev.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code"
  ],
  "includeMcpJson": false,
  "mcpServers": {},
  "hooks": {
    "stop": [
      {
        "command": "node tools/hooks/tone-check.mjs --role frontend-dev",
        "timeout_ms": 60000
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://.kiro/agents/prompts/common.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".env.example",
          "content/personas/**",
          "package-lock.json",
          "package.json",
          "public/**",
          "src/app/**/*.css",
          "src/app/**/*.tsx",
          "src/app/fonts/**",
          "src/components/**",
          "src/lib/cards/**",
          "src/lib/ics/**",
          "src/lib/personas/**",
          "src/lib/recall/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/**",
          ".github/**",
          "tools/**",
          "scripts/check.sh"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "npm *",
          "npx *",
          "node *",
          "bash scripts/check.sh*",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git add *",
          "git commit *",
          "git rev-parse*",
          "git ls-files*",
          "ls*",
          "mkdir *",
          "pwd"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git remote*",
          "git config*",
          "git reset*",
          "git checkout main*",
          "gh *",
          "sudo *",
          "kubectl *",
          "helm install*",
          "helm upgrade*",
          "rm -rf /*",
          "rm -rf ~*",
          "env",
          "printenv*",
          "*github.com*",
          "*api.github*",
          "cd *",
          "*&& cd *",
          "*; cd *",
          "pushd *",
          "*--prefix*",
          "npm -g*",
          "npm * -g*",
          "npm *--global*",
          "npx --yes*",
          "*~/*",
          "*$HOME*",
          "*/home/*"
        ],
        "effect": "deny"
      }
    ]
  }
}
