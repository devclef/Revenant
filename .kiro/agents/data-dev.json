{
  "name": "data-dev",
  "description": "Revenant data engineer: source adapters, figure catalogue, fetch job, figures API and tables.",
  "prompt": "file://./prompts/data-dev.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code"
  ],
  "includeMcpJson": false,
  "mcpServers": {},
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://.kiro/agents/prompts/common.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".env.example",
          "drizzle/**",
          "package-lock.json",
          "package.json",
          "scripts/fetch-figures*",
          "scripts/prefetch*",
          "src/app/api/figures/**",
          "src/lib/db/schema/figures*",
          "src/lib/events/**",
          "src/lib/figures/**",
          "src/lib/sources/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/**",
          ".github/**",
          "tools/**",
          "scripts/check.sh"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "npm *",
          "npx *",
          "node *",
          "bash scripts/check.sh*",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git add *",
          "git commit *",
          "git rev-parse*",
          "git ls-files*",
          "ls*",
          "mkdir *",
          "pwd",
          "docker run*",
          "docker rm*",
          "docker stop*",
          "docker logs*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git remote*",
          "git config*",
          "git reset*",
          "git checkout main*",
          "gh *",
          "sudo *",
          "kubectl *",
          "helm install*",
          "helm upgrade*",
          "rm -rf /*",
          "rm -rf ~*",
          "env",
          "printenv*",
          "*github.com*",
          "*api.github*"
        ],
        "effect": "deny"
      }
    ]
  }
}
