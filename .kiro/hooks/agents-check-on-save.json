{
  "version": "v1",
  "hooks": [
    {
      "name": "Check generated agents are in sync",
      "trigger": "PostFileSave",
      "matcher": "^\\.github/agents\\.json$",
      "action": {
        "type": "command",
        "command": "python3 tools/agents/generate_agents.py --check 2>&1 | tail -30",
        "timeout": 30
      }
    }
  ]
}