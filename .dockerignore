# Keep the Docker build context small and the image lean.
# Kept consistent with .gitignore; the multi-stage build installs
# dependencies and builds inside the image, so local artifacts are excluded.

# Dependencies (reinstalled in the image)
node_modules/

# Next.js build output (rebuilt in the image)
.next/
out/

# Production build / standalone
build/
dist/

# Version control and CI
.git/
.gitignore
.github/

# Project tooling and docs not needed at build time
.kiro/
docs/
tools/*
# ...except the two QA modules that src/ tests import. `next build` type-checks
# every file under tsconfig's include, so these must be in the build context.
# They import only Node built-ins and each other.
!tools/qa
tools/qa/*
!tools/qa/layout-check.mjs
!tools/qa/journey-check.mjs
scripts/
# ...except the migration entrypoint, which the runtime image invokes
# (`node scripts/migrate.mjs`). Un-ignore just that one file.
# The seal-personas and fetch-figures sources are also needed by
# `npm run build` in the builder stage (their *.build.mjs bundlers run there),
# and fetch-figures-freshness.mjs is imported by a test that `next build`
# type-checks, so these script sources must be in the build context.
!scripts/migrate.mjs
!scripts/seal-personas*
!scripts/fetch-figures*
deploy/

# Test coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts.timestamp

# Environment files (never copy secrets into the image; .env.example not needed either)
.env
.env.*

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store

# Python bytecode (tools/)
__pycache__/

# Docker files themselves
Dockerfile
.dockerignore
