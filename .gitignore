# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build / standalone
build/
dist/

# Bundled script build outputs (esbuild). The *.build.mjs scripts emit these;
# `npm run build` regenerates them, so they are never committed. Keep the
# hand-written source scripts (*.build.mjs, migrate.mjs, prefetch-*.mjs) tracked.
scripts/fetch-figures.mjs
scripts/seal-personas.mjs

# Environment files (keep the example checked in)
.env
.env.*
!.env.example

# Test coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts.timestamp

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store

# Python bytecode (tools/)
__pycache__/

# Layout check screenshots (npm run layout-check)
layout-check-shots/

# Walk and QA screenshots (live-walk replay output)
qa-shots/
