{
  "name": "revenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/seal-personas.build.mjs && node scripts/fetch-figures.build.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"dist/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "seal-personas": "node dist/seal-personas.mjs",
    "layout-check": "node tools/qa/layout-check.mjs",
    "prefetch": "node scripts/prefetch-figures.mjs",
    "fetch-figures": "node dist/fetch-figures.mjs",
    "freshness-check": "node scripts/fetch-figures-freshness.mjs",
    "live-walk": "WALK=1 vitest run src/test/integration/live-walk.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e965/xlsx": "0.20.3",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
